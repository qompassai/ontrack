// Slint UI for the Android/desktop-preview build.

import { Button, LineEdit, VerticalBox, HorizontalBox, ComboBox, GroupBox, ProgressIndicator } from "std-widgets.slint";

export struct StopItem {
    label: string,
    address: string,
}

export component AppWindow inherits Window {
    title: "OnTrack";
    preferred-width: 412px;
    preferred-height: 892px;
    background: #002855;

    // ── Bindable state, exposed to Rust ─────────────────────────────────
    in-out property <[StopItem]> stops;
    in-out property <string> new-stop-text;
    in-out property <string> status-text: "";
    in-out property <bool> busy: false;
    in-out property <string> result-summary: "";
    in-out property <[StopItem]> ordered-stops;

    // Settings
    in-out property <string> google-maps-api-key;
    in-out property <string> osrm-base-url: "http://router.project-osrm.org";
    in-out property <string> arcgis-item-id;

    in-out property <int> backend-index: 0;     // 0=OSRM, 1=Google, 2=Haversine

    // Selected tab (custom tab bar below; see note).
    in-out property <int> current-tab: 0;       // 0=Home, 1=Results, 2=Settings

    // ── Callbacks dispatched to Rust ────────────────────────────────────
    callback add-stop();
    callback remove-stop(int);
    callback optimize-route();
    callback open-maps();
    callback export-csv();
    callback use-current-location();
    callback start-voice();
    callback stop-voice();
    callback save-settings();

    VerticalLayout {
        // Keep the whole UI (tab bar included) clear of the system bars.
        // On Android 15+ the window is edge-to-edge, so without this inset
        // the tab bar renders underneath the status bar and taps on the
        // upper part of a tab are swallowed by the system. safe-area-insets
        // is zero on desktop, so the preview is unaffected.
        padding-top: root.safe-area-insets.top;
        padding-right: root.safe-area-insets.right;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        // ── Custom tab bar ──────────────────────────────────────────
        // NOTE: the std TabWidget is intentionally NOT used here. Its tab
        // headers are wrapped in a Flickable which, on Slint 1.16.1, delays
        // every press by 100ms (DelayForwarding) even when there is nothing
        // to pan — and on Android that delayed press never reaches the tab's
        // TouchArea, so taps on the tabs are silently dropped. Upstream fixed
        // this in 1.18.0 (PR #13117: forward the press immediately when the
        // Flickable cannot pan). Until we upgrade, plain Buttons (whose
        // TouchArea gets the press immediately) are the reliable tab switch.
        HorizontalLayout {
            padding: 8px;
            spacing: 4px;
            Button { text: "Home"; clicked => { current-tab = 0; } }
            Button { text: "Results"; clicked => { current-tab = 1; } }
            Button { text: "Settings"; clicked => { current-tab = 2; } }
        }

        // ── Home ────────────────────────────────────────────────────
        if current-tab == 0 : VerticalBox {
            padding: 12px;
            spacing: 8px;
            vertical-stretch: 1;

            HorizontalBox {
                LineEdit {
                    placeholder-text: "Add address…";
                    text <=> new-stop-text;
                    accepted => { root.add-stop(); }
                }
                Button { text: "Add"; clicked => { root.add-stop(); } }
            }
            HorizontalBox {
                Button { text: "📍 Current"; clicked => { root.use-current-location(); } }
                Button { text: "🎤 Voice"; clicked => { root.start-voice(); } }
            }

            GroupBox {
                title: "Stops";
                // NOTE: no ScrollView here on purpose — ScrollView wraps its
                // content in a Flickable with the same 100ms press-delay that
                // breaks the tab bar (see above); the remove buttons must stay
                // directly tappable.
                VerticalLayout {
                    for stop[idx] in stops: HorizontalBox {
                        Text { text: stop.label; width: 28px; }
                        // FIX: without horizontal-stretch the box layout
                        // splits leftover width equally among the growable
                        // children (Slint 1.16.1 box layout: stretch defaults
                        // to 0, and total-stretch 0 means "share equally"),
                        // which blew the remove Button up into a giant
                        // rectangle.
                        Text { text: stop.address; horizontal-stretch: 1; }
                        Button {
                            text: "✕";
                            clicked => { root.remove-stop(idx); }
                        }
                    }
                }
            }

            HorizontalBox {
                Text { text: "Backend:"; vertical-alignment: center; }
                ComboBox {
                    model: ["OSRM (free)", "Google", "Haversine"];
                    current-index <=> backend-index;
                }
            }

            Button {
                text: "🚀  Optimize Route";
                enabled: !busy && stops.length > 0;
                clicked => { root.optimize-route(); }
            }
            if busy: ProgressIndicator { indeterminate: true; }
            Text { text: status-text; }
        }

        // ── Results ─────────────────────────────────────────────────
        if current-tab == 1 : VerticalBox {
            padding: 12px;
            spacing: 8px;
            vertical-stretch: 1;
            Text { text: result-summary; font-size: 16px; }
            HorizontalBox {
                Button { text: "📋 Google Maps"; clicked => { root.open-maps(); } }
                Button { text: "💾 Export CSV"; clicked => { root.export-csv(); } }
            }
            GroupBox {
                title: "Ordered Stops";
                VerticalLayout {
                    for stop[idx] in ordered-stops: HorizontalBox {
                        Text { text: stop.label; width: 28px; }
                        Text { text: stop.address; horizontal-stretch: 1; }
                    }
                }
            }
        }

        // ── Settings ────────────────────────────────────────────────
        if current-tab == 2 : VerticalBox {
            padding: 12px;
            spacing: 8px;
            vertical-stretch: 1;
            // Pack children at their natural height: with every child at
            // stretch 0 the layout would share the page's full height
            // equally among them (the stop-row defect, rotated) and the
            // fields below would balloon into slabs.
            alignment: start;
            Text { text: "Google Maps API key"; }
            LineEdit { text <=> google-maps-api-key; input-type: password; }
            Text { text: "OSRM Base URL"; }
            LineEdit { text <=> osrm-base-url; }
            Text { text: "ArcGIS Item ID"; }
            LineEdit { text <=> arcgis-item-id; }
            Button { text: "💾 Save"; clicked => { root.save-settings(); } }
            Text {
                text: "Keys are stored locally on the device only.";
                color: #c0c8d4;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
